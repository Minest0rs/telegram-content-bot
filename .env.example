# =====================================================================
# Telegram Bot Configuration
# =====================================================================

# Bot token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=

# Bot's own showcase channel for self-promotion posts (optional)
# e.g. @your_bot_showcase_channel or -1001234567890
BOT_SHOWCASE_CHANNEL=

# Bot owner Telegram user ID (for admin commands)
BOT_OWNER_ID=

# =====================================================================
# Telethon (for parsing other Telegram channels as sources)
# Get from https://my.telegram.org -> API Development tools
# =====================================================================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=content_bot

# =====================================================================
# AI Providers (default: Gemini, free tier)
# =====================================================================

# Default text AI provider: gemini | groq | openai | claude
AI_PROVIDER=gemini

# Google Gemini (free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_BASIC=gemini-2.0-flash
GEMINI_MODEL_PREMIUM=gemini-2.5-pro

# Groq (free at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (paid)
OPENAI_API_KEY=
OPENAI_MODEL_BASIC=gpt-4o-mini
OPENAI_MODEL_PREMIUM=gpt-4o

# Anthropic Claude (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# =====================================================================
# Image Sources
# =====================================================================

# Unsplash (free at https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

# Pexels (free at https://www.pexels.com/api/)
PEXELS_API_KEY=

# Pollinations.ai is keyless (default fallback for image generation)

# =====================================================================
# Database
# =====================================================================
DATABASE_URL=postgresql+asyncpg://content_bot:content_bot@postgres:5432/content_bot

# =====================================================================
# Redis (queue + cache)
# =====================================================================
REDIS_URL=redis://redis:6379/0

# =====================================================================
# App Settings
# =====================================================================

# Default language: ru | en | es
DEFAULT_LOCALE=ru

# Watermark scan interval (seconds; default 3600 = 1 hour)
WATERMARK_SCAN_INTERVAL=3600

# Logging level
LOG_LEVEL=INFO
